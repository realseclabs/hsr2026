{
  "routes": [
    {
      "src": "/",
      "status": 308,
      "headers": {
        "Location": "/events/hsr2026"
      }
    },
    {
      "src": "/events/?",
      "status": 308,
      "headers": {
        "Location": "/events/hsr2026"
      }
    },
    {
      "src": "/events/hsr2026/?",
      "dest": "/index.html"
    },
    {
      "src": "/events/hsr2026/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/events/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
